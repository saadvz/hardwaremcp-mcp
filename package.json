{
  "name": "hardwaremcp",
  "version": "0.1.0",
  "description": "MCP server for finding MCP servers that connect AI agents to hardware (ESP32, 3D printers, Home Assistant, cameras).",
  "scripts": {
    "gen-data": "node gen-data.mjs",
    "build": "tsc && chmod +x dist/stdio.js",
    "start": "node dist/stdio.js",
    "test": "node test-client.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hardware",
    "esp32",
    "home-assistant",
    "3d-printing",
    "bambu",
    "klipper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "hardwaremcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://hardwaremcp.khanex.ai/mcp/",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/core.js"
}
